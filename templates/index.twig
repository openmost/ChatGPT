{% extends 'dashboard.twig' %}

{% block content %}

    {% if is_configured and not data_sharing_allowed %}

        <div class="alert alert-info">
            <strong>{{ 'ChatGPT_DataSharingNotAllowedTitle'|translate }}</strong>
            {{ 'ChatGPT_DataSharingNotAllowed'|translate }}
            {% if settings_url %}
                <a href="{{ settings_url }}#chatGptPrivacy">{{ 'ChatGPT_DataSharingSettingsLink'|translate }}</a>
            {% else %}
                {{ 'ChatGPT_AskAdministrator'|translate }}
            {% endif %}
        </div>

    {% elseif is_configured %}

        <div vue-entry="ChatGPT.ChatIndexPage"
             ai-name="chat-gpt"
             ai-label="{{ display_name }}"
             ai-color="#00A67E"
             api-method="ChatGPT.getResponse"
             model-notice="{{ model_notice|json_encode|e('html_attr') }}"
        ></div>

    {% else %}

        <div class="alert alert-info">
            <strong>{{ 'ChatGPT_PluginNotConfigured'|translate }}</strong>
            {{ 'ChatGPT_PluginNotConfiguredDescription'|translate }}
            {% if settings_url %}
                <a href="{{ settings_url }}">{{ 'ChatGPT_SystemSettingsLink'|translate }}</a>
            {% endif %}
        </div>

    {% endif %}

{% endblock %}

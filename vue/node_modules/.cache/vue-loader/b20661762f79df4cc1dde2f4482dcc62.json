t(): string {\n      return translate('ChatGPT_Submit');\n    },\n    placeholderText(): string {\n      return translate('ChatGPT_MessagePlaceholder', this.aiLabel);\n    },\n  },\n  methods: {\n    onSubmit() {\n      if (!this.prompt.trim()) return;\n      this.$emit('prompt', { role: 'user', content: this.prompt });\n      this.prompt = '';\n    },\n  },\n});\n</script>\n\n<style lang=\"less\" scoped>\n.ai-chat-form-wrapper {\n  flex-shrink: 0;\n  padding: 1rem;\n  background: #f5f5f5;\n  border-top: 1px solid #e0e0e0;\n\n  .ai-chat-form {\n    display: flex;\n    align-items: flex-start;\n    gap: 1rem;\n    max-width: 730px;\n    margin: 0 auto;\n\n    .ai-chat-input-wrapper {\n      flex: 1;\n\n      :deep(.matomo-form-field) {\n        margin-bottom: 0;\n\n        .form-group {\n          margin-bottom: 0;\n        }\n\n        .form-help {\n          display: none;\n        }\n\n        .input-field {\n          margin-top: 0;\n          margin-bottom: 0;\n        }\n\n        input {\n          margin-bottom: 0;\n        }\n\n        label {\n          display: none;\n        }\n      }\n    }\n\n    :deep(.matomo-save-button) {\n      margin-top: 0;\n    }\n  }\n}\n</style>\n"]}]}
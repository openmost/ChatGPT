AAC,EAAE,CAAC,CAAC,CAAC,CAAC,CAAC,EAAE;MACvB,CAAC,CAAC,CAAC,CAAC,CAAC,EAAE,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,EAAE,CAAC,CAAC,EAAE,CAAC,CAAC,CAAC,CAAC,CAAC;QAChC,EAAE,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC;QACzB,EAAE,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC;IAC7B,CAAC;EACH,CAAC;AACH,CAAC,CAAC","file":"/Applications/MAMP/htdocs/matomo/plugins/ChatGPT/vue/src/Components/Chat/ChatMessage.vue","sourceRoot":"","sourcesContent":["<template>\n  <li :class=\"chatResponseClasses\">\n    <div class=\"ai-chat-response-avatar\">\n      <IconAi v-if=\"message.role === 'assistant'\" :aiName=\"aiName\"/>\n      <IconUser v-if=\"message.role === 'user'\"/>\n    </div>\n    <div class=\"ai-chat-response-content-wrapper\">\n      <span class=\"ai-chat-response-username\">{{ chatAuthorName }}</span>\n      <div class=\"ai-chat-response-body\">\n        <Markdown :markdown=\"message.content\"/>\n        <span v-if=\"isStreaming\" class=\"streaming-cursor\">▊</span>\n      </div>\n    </div>\n  </li>\n</template>\n\n<script lang=\"ts\">\nimport { defineComponent } from 'vue';\nimport { translate } from 'CoreHome';\nimport Markdown from '../Markdown.vue';\nimport IconAi from '../Icon/IconAi.vue';\nimport IconUser from '../Icon/IconUser.vue';\n\nexport default defineComponent({\n  components: {\n    IconUser,\n    IconAi,\n    Markdown,\n  },\n  props: {\n    message: {\n      type: Object,\n      required: true,\n    },\n    aiName: {\n      type: String,\n      required: true,\n    },\n    aiColor: {\n      type: String,\n      default: '#3450a3',\n    },\n    isStreaming: {\n      type: Boolean,\n      default: false,\n    },\n  },\n  computed: {\n    chatResponseClasses(): Array<string> {\n      const classes = [\n        'ai-chat-response',\n        `ai-chat-${this.message.role}-response`,\n      ];\n      if (this.isStreaming) {\n        classes.push('ai-chat-streaming');\n      }\n      return classes;\n    },\n    chatAuthorName(): string {\n      return this.message.role === 'user'\n        ? translate('ChatGPT_You')\n        : translate('ChatGPT_AI');\n    },\n  },\n});\n</script>\n\n<style lang=\"less\" scoped>\n.ai-chat-response {\n  width: 100%;\n  display: flex;\n  gap: .5rem;\n\n  &.ai-chat-assistant-response .ai-chat-response-avatar {\n    background-color: v-bind(aiColor);\n    border-color: v-bind(aiColor);\n  }\n\n  &.ai-chat-user-response .ai-chat-response-avatar {\n    background-color: #3450a3;\n    color: #152b6c;\n    border-color: #3450a3;\n  }\n\n  &.ai-chat-streaming {\n    .ai-chat-response-body {\n      display: flex;\n      flex-wrap: wrap;\n      align-items: flex-end;\n    }\n  }\n\n  .ai-chat-response-avatar {\n    border: 1px solid currentColor;\n    width: 1.5rem;\n    min-width: 1.5rem;\n    height: 1.5rem;\n    aspect-ratio: 1;\n    border-radius: 50%;\n    overflow: hidden;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    padding: 4px;\n\n    svg {\n      width: .875rem;\n      height: auto;\n    }\n  }\n\n  .ai-chat-response-content-wrapper {\n    flex-grow: 1;\n    max-width: calc(100% - 32px);\n\n    .ai-chat-response-username {\n      display: block;\n      font-weight: 700;\n      font-size: 1.125rem;\n      margin-bottom: 4px;\n    }\n\n    .streaming-cursor {\n      display: inline-block;\n      color: v-bind(aiColor);\n      animation: blink 1s step-end infinite;\n      margin-left: 2px;\n      font-weight: normal;\n    }\n  }\n}\n\n@keyframes blink {\n  0%, 100% { opacity: 1; }\n  50% { opacity: 0; }\n}\n</style>\n"]}]}
mpt\"\n          :placeholder=\"placeholderText\"\n          :disabled=\"loading\"\n          :full-width=\"true\"\n        />\n      </div>\n      <SaveButton\n        :saving=\"loading\"\n        :value=\"submitText\"\n        :disabled=\"!prompt.trim()\"\n        @confirm=\"onSubmit\"\n      />\n    </form>\n  </div>\n</template>\n\n<script lang=\"ts\">\nimport { defineComponent } from 'vue';\nimport { translate } from 'CoreHome';\nimport { Field, SaveButton } from 'CorePluginsAdmin';\n\nexport default defineComponent({\n  components: {\n    Field,\n    SaveButton,\n  },\n  props: {\n    aiLabel: { type: String, required: true },\n    loading: { type: Boolean, default: false },\n  },\n  data() {\n    return {\n      prompt: '',\n    };\n  },\n  computed: {\n    submitText(): string {\n      return translate('ChatGPT_Submit');\n    },\n    placeholderText(): string {\n      return translate('ChatGPT_MessagePlaceholder', this.aiLabel);\n    },\n  },\n  methods: {\n    onSubmit() {\n      if (!this.prompt.trim()) return;\n      this.$emit('prompt', { role: 'user', content: this.prompt });\n      this.prompt = '';\n    },\n  },\n});\n</script>\n\n<style lang=\"less\" scoped>\n.ai-chat-form-wrapper {\n  flex-shrink: 0;\n  padding: 1rem;\n  background: #f5f5f5;\n  border-top: 1px solid #e0e0e0;\n\n  .ai-chat-form {\n    display: flex;\n    align-items: flex-start;\n    gap: 1rem;\n    max-width: 730px;\n    margin: 0 auto;\n\n    .ai-chat-input-wrapper {\n      flex: 1;\n\n      :deep(.matomo-form-field) {\n        margin-bottom: 0;\n\n        .form-group {\n          margin-bottom: 0;\n        }\n\n        .form-help {\n          display: none;\n        }\n\n        .input-field {\n          margin-top: 0;\n          margin-bottom: 0;\n        }\n\n        input {\n          margin-bottom: 0;\n        }\n\n        label {\n          display: none;\n        }\n      }\n    }\n\n    :deep(.matomo-save-button) {\n      margin-top: 0;\n    }\n  }\n}\n</style>\n"]}]}